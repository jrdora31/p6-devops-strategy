---
# Surcharge le chart Traefik fourni par K3s sans gérer une seconde release.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    # Les en-têtes et paramètres sont exclus pour limiter la collecte de
    # données potentiellement sensibles.
    accessLog:
      enabled: true
      format: json
      fields:
        headers:
          defaultMode: drop
        queryParameters:
          defaultMode: drop
    # Deux réplicas sont demandés et répartis de préférence entre les nœuds.
    deployment:
      replicas: 2
    affinity:
      podAntiAffinity:
        preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/name: traefik
              topologyKey: kubernetes.io/hostname
