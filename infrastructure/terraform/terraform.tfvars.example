# Valeurs non sensibles du cluster partagé. Les deux EC2 sont possédées par
# l'unique state GitLab microcrm-poc.
aws_region            = "eu-west-3"
project_name          = "microcrm"
environment           = "poc"
network_state_address = "https://gitlab.com/api/v4/projects/PROJECT_ID/terraform/state/microcrm-network"
instance_type         = "m7i-flex.large"
root_volume_size      = 20

cloudwatch_agent_enabled = false

# Après le premier plan, renseigner l'AMI observée pour rendre les plans suivants
# strictement reproductibles.
# ami_id = "ami-0123456789abcdef0"
