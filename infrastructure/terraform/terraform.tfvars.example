# Valeurs non sensibles du POC. Copier ce fichier hors du repository uniquement
# si une surcharge locale est nécessaire.
aws_region         = "eu-west-3"
project_name       = "microcrm"
environment        = "poc"
instance_type      = "m7i-flex.large"
cloudwatch_agent_enabled = false
cloudwatch_log_group_prefix = "/microcrm/poc"
root_volume_size   = 20
http_ingress_cidrs = ["0.0.0.0/0"]

# Après le premier plan, renseigner l'AMI observée pour rendre les plans suivants
# strictement reproductibles.
# ami_id = "ami-0123456789abcdef0"
