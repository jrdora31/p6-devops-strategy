{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["release", "nodeSelector", "frontend", "backend", "database", "registrySecret", "monitoringAuth", "canary"],
  "properties": {
    "release": {
      "type": "object",
      "required": ["environment", "version"],
      "properties": {
        "environment": { "enum": ["development", "staging", "production"] },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "registrySecret": {
      "type": "object",
      "required": ["enabled", "name", "server", "usernameBase64", "passwordBase64"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "server": { "type": "string" },
        "usernameBase64": { "type": "string" },
        "passwordBase64": { "type": "string" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["replicaCount", "podAntiAffinity", "image", "service", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 2 },
        "podAntiAffinity": { "$ref": "#/definitions/podAntiAffinity" },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "backend": {
      "type": "object",
      "required": ["replicaCount", "podAntiAffinity", "image", "service", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 2 },
        "podAntiAffinity": { "$ref": "#/definitions/podAntiAffinity" },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "monitoringAuth": {
      "type": "object",
      "required": ["existingSecret", "usernameKey", "passwordKey", "managedSecret"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "managedSecret": {
          "type": "object",
          "required": ["enabled", "username", "passwordBase64"],
          "properties": {
            "enabled": { "type": "boolean" },
            "username": { "type": "string", "minLength": 1 },
            "passwordBase64": { "type": "string" }
          }
        }
      }
    },
    "canary": {
      "type": "object",
      "required": ["enabled", "stableWeight", "canaryWeight", "version", "frontend", "backend"],
      "properties": {
        "enabled": { "type": "boolean" },
        "stableWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "canaryWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "version": { "type": "string" },
        "frontend": { "$ref": "#/definitions/canaryComponent" },
        "backend": { "$ref": "#/definitions/canaryComponent" }
      }
    },
    "database": {
      "type": "object",
      "required": ["image", "name", "existingSecret", "usernameKey", "passwordKey", "managedSecret", "persistence"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "name": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "managedSecret": {
          "type": "object",
          "required": ["enabled", "username", "passwordBase64"],
          "properties": {
            "enabled": { "type": "boolean" },
            "username": { "type": "string", "minLength": 1 },
            "passwordBase64": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
            "storageClass": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "canaryComponent": {
      "type": "object",
      "required": ["replicaCount", "image"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "podAntiAffinity": {
      "type": "object",
      "required": ["enabled", "weight", "topologyKey"],
      "properties": {
        "enabled": { "type": "boolean" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "topologyKey": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
